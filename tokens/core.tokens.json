{
  "$description": "EKOA — tokens independientes del tema (DTCG 2025.10).",
  "font": {
    "$type": "fontFamily",
    "family": {
      "display": {
        "$value": [
          "Archivo",
          "-apple-system",
          "SF Pro Display",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Títulos y texto muy grande (Title 3 hacia arriba). Archivo se carga desde Google Fonts con pesos 700 y 800."
      },
      "sans": {
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "SF Pro Text",
          "SF Pro Display",
          "system-ui",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Texto de Headline hacia abajo. SF Pro se pide con la pila del sistema porque Apple no permite redistribuir el archivo."
      }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Escala tipográfica al estilo de los text styles de iOS. lineHeight es un multiplicador (DTCG); la altura exacta en px está en $extensions. letterSpacing se expresa en px (DTCG no admite em); el valor original en em está en $extensions.",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.8,
          "unit": "px"
        },
        "lineHeight": 1.1
      },
      "$description": "Texto muy grande: cifras destacadas, portadas y pantallas de bienvenida. Nunca en cuerpo de texto.",
      "$extensions": {
        "com.ekoa": {
          "lineHeightPx": 44,
          "letterSpacingEm": -0.02
        }
      }
    },
    "large-title": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 34,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.68,
          "unit": "px"
        },
        "lineHeight": 1.205882
      },
      "$description": "Equivale a Large Title de iOS: título grande de cada pantalla principal, bajo la barra de navegación. Una vez por pantalla.",
      "$extensions": {
        "com.ekoa": {
          "lineHeightPx": 41,
          "letterSpacingEm": -0.02
        }
      }
    },
    "title-1": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.42,
          "unit": "px"
        },
        "lineHeight": 1.214286
      },
      "$description": "Equivale a Title 1: título de pantalla de detalle o de resumen.",
      "$extensions": {
        "com.ekoa": {
          "lineHeightPx": 34,
          "letterSpacingEm": -0.015
        }
      }
    },
    "title-2": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 22,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.22,
          "unit": "px"
        },
        "lineHeight": 1.272727
      },
      "$description": "Equivale a Title 2: título de sección destacada.",
      "$extensions": {
        "com.ekoa": {
          "lineHeightPx": 28,
          "letterSpacingEm": -0.01
        }
      }
    },
    "title-3": {
      "$value": {
        "fontFamily": "{font.family.display}",
